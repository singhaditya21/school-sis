{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2020",
    "lib": [
      "esnext",
      "dom"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "typeRoots": [
      "../../apps/web/node_modules/@types"
    ],
    "paths": {
      "pg": [
        "../../apps/web/node_modules/@types/pg"
      ],
      "pg/*": [
        "../../apps/web/node_modules/@types/pg/*"
      ],
      "@/lib/db": [
        "./src/db/index.ts"
      ],
      "@/lib/db/*": [
        "./src/db/*"
      ],
      "@/lib/services/*": [
        "./src/services/*"
      ],
      "@/lib/validations": [
        "./src/validations.ts"
      ],
      "@/lib/config/limits": [
        "./src/config/limits.ts"
      ],
      "@/*": [
        "../../apps/web/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts"
  ]
}
