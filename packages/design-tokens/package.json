{
  "name": "@school-sis/design-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./native": "./src/native.ts",
    "./web": "./src/web.ts",
    "./tokens.css": "./src/tokens.css",
    "./tokens.json": "./tokens.json"
  },
  "scripts": {
    "build": "node scripts/generate.mjs --check && node scripts/check-contrast.mjs",
    "check": "node scripts/generate.mjs --check && node scripts/check-contrast.mjs",
    "generate": "node scripts/generate.mjs",
    "test": "node scripts/check-contrast.mjs && node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
