{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "ScholarMind cross-platform design tokens. This is the only hand-edited token source.",
  "primitive": {
    "color": {
      "$type": "color",
      "white": { "$value": "#ffffff" },
      "slate50": { "$value": "#f8fafc" },
      "slate100": { "$value": "#f1f5f9" },
      "slate200": { "$value": "#e2e8f0" },
      "slate300": { "$value": "#cbd5e1" },
      "slate400": { "$value": "#94a3b8" },
      "slate500": { "$value": "#64748b" },
      "slate600": { "$value": "#475569" },
      "slate700": { "$value": "#334155" },
      "slate800": { "$value": "#1e293b" },
      "slate900": { "$value": "#0f172a" },
      "slate950": { "$value": "#020617" },
      "indigo50": { "$value": "#eef2ff" },
      "indigo200": { "$value": "#c7d2fe" },
      "indigo500": { "$value": "#6366f1" },
      "indigo600": { "$value": "#4f46e5" },
      "indigo700": { "$value": "#4338ca" },
      "blue50": { "$value": "#eff6ff" },
      "blue600": { "$value": "#2563eb" },
      "blue800": { "$value": "#1e40af" },
      "emerald50": { "$value": "#ecfdf5" },
      "emerald600": { "$value": "#059669" },
      "emerald700": { "$value": "#047857" },
      "emerald800": { "$value": "#065f46" },
      "amber50": { "$value": "#fffbeb" },
      "amber700": { "$value": "#b45309" },
      "amber900": { "$value": "#78350f" },
      "red50": { "$value": "#fef2f2" },
      "red600": { "$value": "#dc2626" },
      "red800": { "$value": "#991b1b" },
      "violet500": { "$value": "#8b5cf6" },
      "cyan600": { "$value": "#0891b2" },
      "pink600": { "$value": "#db2777" }
    },
    "fontFamily": {
      "$type": "fontFamily",
      "sans": { "$value": "var(--font-inter, Inter), ui-sans-serif, system-ui, sans-serif" },
      "mono": { "$value": "var(--font-geist-mono, 'Geist Mono'), ui-monospace, SFMono-Regular, monospace" }
    },
    "fontSize": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem" },
      "md": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" },
      "xl": { "$value": "1.25rem" },
      "2xl": { "$value": "1.5rem" },
      "3xl": { "$value": "1.875rem" }
    },
    "space": {
      "$type": "dimension",
      "0": { "$value": "0" },
      "1": { "$value": "0.25rem" },
      "2": { "$value": "0.5rem" },
      "3": { "$value": "0.75rem" },
      "4": { "$value": "1rem" },
      "5": { "$value": "1.25rem" },
      "6": { "$value": "1.5rem" },
      "8": { "$value": "2rem" },
      "10": { "$value": "2.5rem" },
      "12": { "$value": "3rem" }
    },
    "radius": {
      "$type": "dimension",
      "sm": { "$value": "0.375rem" },
      "md": { "$value": "0.5rem" },
      "lg": { "$value": "0.75rem" },
      "xl": { "$value": "1rem" },
      "full": { "$value": "9999px" }
    },
    "elevation": {
      "$type": "shadow",
      "sm": { "$value": "0 1px 2px rgb(15 23 42 / 0.08)" },
      "md": { "$value": "0 4px 12px rgb(15 23 42 / 0.10)" },
      "lg": { "$value": "0 12px 28px rgb(15 23 42 / 0.14)" }
    },
    "motion": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "normal": { "$value": "200ms" },
      "slow": { "$value": "320ms" }
    },
    "breakpoint": {
      "$type": "dimension",
      "sm": { "$value": "640px" },
      "md": { "$value": "768px" },
      "lg": { "$value": "1024px" },
      "xl": { "$value": "1280px" }
    },
    "zIndex": {
      "$type": "number",
      "base": { "$value": 0 },
      "dropdown": { "$value": 1000 },
      "sticky": { "$value": 1100 },
      "overlay": { "$value": 1200 },
      "modal": { "$value": 1300 },
      "toast": { "$value": 1400 }
    },
    "density": {
      "$type": "dimension",
      "controlCompact": { "$value": "2rem" },
      "controlDefault": { "$value": "2.5rem" },
      "controlComfortable": { "$value": "2.75rem" },
      "touchTarget": { "$value": "2.75rem" }
    }
  },
  "semantic": {
    "light": {
      "$type": "color",
      "background": { "$value": "{primitive.color.white}" },
      "foreground": { "$value": "{primitive.color.slate950}" },
      "card": { "$value": "{primitive.color.white}" },
      "cardForeground": { "$value": "{primitive.color.slate950}" },
      "popover": { "$value": "{primitive.color.white}" },
      "popoverForeground": { "$value": "{primitive.color.slate950}" },
      "primary": { "$value": "{primitive.color.indigo600}" },
      "primaryHover": { "$value": "{primitive.color.indigo700}" },
      "primaryForeground": { "$value": "{primitive.color.white}" },
      "secondary": { "$value": "{primitive.color.slate100}" },
      "secondaryForeground": { "$value": "{primitive.color.slate900}" },
      "muted": { "$value": "{primitive.color.slate100}" },
      "mutedForeground": { "$value": "{primitive.color.slate600}" },
      "accent": { "$value": "{primitive.color.indigo50}" },
      "accentForeground": { "$value": "{primitive.color.indigo700}" },
      "border": { "$value": "{primitive.color.slate200}" },
      "input": { "$value": "{primitive.color.slate300}" },
      "focus": { "$value": "{primitive.color.indigo600}" },
      "danger": { "$value": "{primitive.color.red600}" },
      "dangerForeground": { "$value": "{primitive.color.white}" },
      "dangerMuted": { "$value": "{primitive.color.red50}" },
      "success": { "$value": "{primitive.color.emerald700}" },
      "successForeground": { "$value": "{primitive.color.white}" },
      "successMuted": { "$value": "{primitive.color.emerald50}" },
      "warning": { "$value": "{primitive.color.amber700}" },
      "warningForeground": { "$value": "{primitive.color.white}" },
      "warningMuted": { "$value": "{primitive.color.amber50}" },
      "info": { "$value": "{primitive.color.blue600}" },
      "infoForeground": { "$value": "{primitive.color.white}" },
      "infoMuted": { "$value": "{primitive.color.blue50}" },
      "chart1": { "$value": "{primitive.color.indigo600}" },
      "chart2": { "$value": "{primitive.color.emerald600}" },
      "chart3": { "$value": "{primitive.color.cyan600}" },
      "chart4": { "$value": "{primitive.color.violet500}" },
      "chart5": { "$value": "{primitive.color.pink600}" }
    },
    "dark": {
      "$type": "color",
      "background": { "$value": "{primitive.color.slate950}" },
      "foreground": { "$value": "{primitive.color.slate50}" },
      "card": { "$value": "{primitive.color.slate900}" },
      "cardForeground": { "$value": "{primitive.color.slate50}" },
      "popover": { "$value": "{primitive.color.slate900}" },
      "popoverForeground": { "$value": "{primitive.color.slate50}" },
      "primary": { "$value": "{primitive.color.indigo600}" },
      "primaryHover": { "$value": "{primitive.color.indigo700}" },
      "primaryForeground": { "$value": "{primitive.color.white}" },
      "secondary": { "$value": "{primitive.color.slate800}" },
      "secondaryForeground": { "$value": "{primitive.color.slate50}" },
      "muted": { "$value": "{primitive.color.slate800}" },
      "mutedForeground": { "$value": "{primitive.color.slate400}" },
      "accent": { "$value": "{primitive.color.slate800}" },
      "accentForeground": { "$value": "{primitive.color.indigo200}" },
      "border": { "$value": "{primitive.color.slate700}" },
      "input": { "$value": "{primitive.color.slate700}" },
      "focus": { "$value": "{primitive.color.indigo500}" },
      "danger": { "$value": "{primitive.color.red600}" },
      "dangerForeground": { "$value": "{primitive.color.white}" },
      "dangerMuted": { "$value": "{primitive.color.red800}" },
      "success": { "$value": "{primitive.color.emerald700}" },
      "successForeground": { "$value": "{primitive.color.white}" },
      "successMuted": { "$value": "{primitive.color.emerald800}" },
      "warning": { "$value": "{primitive.color.amber700}" },
      "warningForeground": { "$value": "{primitive.color.white}" },
      "warningMuted": { "$value": "{primitive.color.amber900}" },
      "info": { "$value": "{primitive.color.blue600}" },
      "infoForeground": { "$value": "{primitive.color.white}" },
      "infoMuted": { "$value": "{primitive.color.blue800}" },
      "chart1": { "$value": "{primitive.color.indigo500}" },
      "chart2": { "$value": "{primitive.color.emerald600}" },
      "chart3": { "$value": "{primitive.color.cyan600}" },
      "chart4": { "$value": "{primitive.color.violet500}" },
      "chart5": { "$value": "{primitive.color.pink600}" }
    }
  }
}
