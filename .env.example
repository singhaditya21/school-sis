# ─── School-SIS Environment Variables ─────────────────────
# Copy this file to .env and fill in values.
# NEVER commit .env to version control!

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://school_admin:CHANGE_ME@localhost:5432/school_sis

# ─── Authentication ───────────────────────────────────────
SESSION_SECRET=generate-a-32-char-random-string-here
ENCRYPTION_KEY=generate-a-32-char-hex-string-here

# ─── Application ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── File Storage ─────────────────────────────────────────
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
# For S3:
# STORAGE_PROVIDER=s3
# S3_BUCKET=school-sis-uploads
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ─── Background Jobs ─────────────────────────────────────
JOB_QUEUE_MODE=database
JOB_DISPATCH_SECRET=generate-a-32-char-random-string-here

# ─── Performance / Scale ─────────────────────────────────
# Production must explicitly select `postgres` or `redis`; local development
# defaults to in-memory limiting when RATE_LIMIT_BACKEND is unset.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_BACKEND=postgres
# RATE_LIMIT_MEMORY_MAX_ENTRIES=10000  # bounded strict outage fallback
BUNDLE_MAX_TOTAL_KB=10000
BUNDLE_MAX_ROUTE_KB=2500
LOAD_TEST_BASE_URL=http://localhost:3000
LOAD_TEST_DURATION_SECONDS=15
LOAD_TEST_CONCURRENCY=5
LOAD_TEST_PATHS=/api/health,/login

# ─── Observability / SRE ─────────────────────────────────
METRICS_TOKEN=generate-a-32-char-random-string-here
# Production enforces CSP by default. Set false only as a temporary rollback while investigating reports.
# CSP_ENFORCE=true
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Razorpay (Payment Gateway) ──────────────────────────
# RAZORPAY_KEY_ID=rzp_live_xxxxx
# RAZORPAY_SECRET=xxxxx

# ─── Communication (Email/SMS/WhatsApp/Push) ──────────────
# Development/test-only mock delivery requires both the explicit opt-in and
# per-channel selection. Production startup rejects every mock value below.
# ENABLE_INTEGRATION_MOCKS=true
# EMAIL_PROVIDER=mock
# SMS_PROVIDER=mock
# WHATSAPP_PROVIDER=mock
# PUSH_PROVIDER=mock
# Live selectors: EMAIL_PROVIDER=resend|smtp, SMS_PROVIDER=msg91|twilio,
# WHATSAPP_PROVIDER=twilio, PUSH_PROVIDER=firebase. Unset = disabled.
# REQUIRED_NOTIFICATION_CHANNELS=email,sms,whatsapp,push
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=whsec_...
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_FROM_NUMBER=
# TWILIO_WHATSAPP_FROM_NUMBER=
# NOTIFICATION_TWILIO_STATUS_CALLBACK_URL=https://sis.example.edu/api/webhooks/notifications/twilio
# FIREBASE_PROJECT_ID= / FIREBASE_CLIENT_EMAIL= / FIREBASE_PRIVATE_KEY=
# NOTIFICATION_RECEIPT_WEBHOOK_SECRET=generate-a-32-char-random-string-here

# ─── Docker Compose ──────────────────────────────────────
# DB_PASSWORD=school_sis_dev_2026
