# School SIS — web environment contract
# Copy to .env.local for local development. Do not commit real secrets.
#
# Two sections:
#   1) REQUIRED — the production deploy gate (`pnpm infra:check --strict`) fails
#      without these. This is the complete must-have set.
#   2) OPTIONAL — capabilities are opt-in. Leave them unset to ship a lean deploy;
#      the app degrades gracefully (no online payments, in-app notifications only,
#      etc.). Enable a capability by setting its selector + secrets.

# ─────────────────────────────────────────────────────────────────────────────
# 1) REQUIRED (8)
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated production tenant base domains (hostnames only, no protocol).
# Example: school.example.edu,portal.example.edu   (localhost is fine for dev)
TENANT_BASE_HOSTS=localhost

# Local Postgres (scripts/local-db.sh, port 5433, pgvector). DIRECT_URL is the
# same locally; it exists so drizzle tooling and the app can use distinct URLs.
DATABASE_URL=postgresql://postgres@localhost:5433/school_sis?sslmode=disable
DIRECT_URL=postgresql://postgres@localhost:5433/school_sis?sslmode=disable
# Remote databases default to verify-full. DATABASE_SSL_MODE=require is an
# explicit compatibility waiver; disable is accepted only for localhost.
# DATABASE_SSL_MODE=verify-full

# Secrets — each at least 32 random characters.
SESSION_SECRET=replace_with_at_least_32_random_characters
PII_ENCRYPTION_KEY=replace_with_at_least_32_random_characters   # or set ENCRYPTION_KEY instead
JOB_DISPATCH_SECRET=replace_with_at_least_32_random_characters  # secures /api/jobs/dispatch
CRON_SECRET=replace_with_at_least_32_random_characters          # required when using Vercel Cron

# ─────────────────────────────────────────────────────────────────────────────
# 2) OPTIONAL — capabilities (unset = disabled, app degrades gracefully)
# ─────────────────────────────────────────────────────────────────────────────

# Runtime modes
NODE_ENV=development
INTEGRATIONS_MODE=live
JOB_QUEUE_MODE=database
# Development/test only: both values are required to enable signed-delivery
# short-circuits. Production startup rejects either mock setting.
# ENABLE_INTEGRATION_MOCKS=true
# INTEGRATIONS_MODE=mock

# Online payments — single provider. Unset/none = payments disabled.
# PAYMENT_PROVIDER=stripe        # or: razorpay
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...

# External notifications — unset = in-app only. Opt in per channel.
# REQUIRED_NOTIFICATION_CHANNELS=email,sms,whatsapp,push
# EMAIL_PROVIDER=resend          # or: smtp
# RESEND_API_KEY=...
# RESEND_WEBHOOK_SECRET=whsec_... # required with Resend; signs delivery receipts
# SMTP_HOST= / SMTP_USER= / SMTP_PASS=
# SMS_PROVIDER=msg91             # or: twilio
# MSG91_AUTH_KEY=...
# TWILIO_ACCOUNT_SID=AC... / TWILIO_AUTH_TOKEN=... / TWILIO_FROM_NUMBER=...
# NOTIFICATION_TWILIO_STATUS_CALLBACK_URL=https://sis.example.edu/api/webhooks/notifications/twilio
# WHATSAPP_PROVIDER=twilio
# TWILIO_WHATSAPP_FROM_NUMBER=+14155238886
# PUSH_PROVIDER=firebase
# FIREBASE_PROJECT_ID= / FIREBASE_CLIENT_EMAIL= / FIREBASE_PRIVATE_KEY=
# Shared HMAC secret for a trusted MSG91/Firebase/SMTP receipt bridge (32+ random characters).
# NOTIFICATION_RECEIPT_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
# Leave any provider selector unset to disable that channel explicitly.

# LTI 1.3 — configure either one platform with the fields below, or multiple
# platforms with LTI_PLATFORMS_JSON. LTI_STATE_SECRET may reuse SESSION_SECRET.
# The trusted platform must map its OIDC `sub` to the corresponding School SIS
# user UUID. Launches fail closed if the local account or learner/teacher role differs.
# LTI_ISSUER=https://lms.example.edu
# LTI_CLIENT_ID=
# LTI_JWKS_URL=https://lms.example.edu/.well-known/jwks.json
# LTI_AUTHORIZATION_URL=https://lms.example.edu/oidc/auth
# LTI_DEPLOYMENT_ID=
# LTI_TENANT_ID=00000000-0000-4000-8000-000000000000
# LTI_REDIRECT_URI=https://sis.example.edu/api/lti/launch
# LTI_STATE_SECRET=replace_with_at_least_32_random_characters
# LTI_PLATFORMS_JSON=[{"issuer":"https://lms.example.edu","clientId":"...","jwksUrl":"https://lms.example.edu/.well-known/jwks.json","authorizationUrl":"https://lms.example.edu/oidc/auth","deploymentId":"...","tenantId":"00000000-0000-4000-8000-000000000000","redirectUri":"https://sis.example.edu/api/lti/launch"}]

# File storage — unset = upload/download features unavailable. Prefer R2.
# R2_ACCOUNT_ID= / R2_ACCESS_KEY_ID= / R2_SECRET_ACCESS_KEY= / R2_BUCKET_NAME=
# STORAGE_CDN_BASE_URL=https://cdn.example.com
# AWS_REGION= / AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= / AWS_S3_BUCKET=   # S3 fallback

# AI features — provider credentials are the capability gates. Unset = disabled.
# Native report copilot (OpenAI-compatible Cerebras endpoint).
# CEREBRAS_API_KEY= / CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# COPILOT_PRIMARY_MODEL=llama3.1-8b
# COPILOT_PRIMARY_INPUT_USD_PER_MILLION=1
# COPILOT_PRIMARY_OUTPUT_USD_PER_MILLION=1
# Optional different-failure-domain fallback; all three values are required together.
# COPILOT_FALLBACK_API_KEY=
# COPILOT_FALLBACK_BASE_URL=https://fallback-provider.example.com/v1
# COPILOT_FALLBACK_MODEL=explicit-model-id
# COPILOT_FALLBACK_PROVIDER_NAME=secondary-provider
# COPILOT_FALLBACK_INPUT_USD_PER_MILLION=5
# COPILOT_FALLBACK_OUTPUT_USD_PER_MILLION=5
# Monthly hard ceilings. Defaults shown; requests reserve worst-case tokens/cost atomically.
# AI_TENANT_MONTHLY_TOKEN_BUDGET=5000000 / AI_TENANT_MONTHLY_COST_USD=50
# AI_USER_MONTHLY_TOKEN_BUDGET=250000 / AI_USER_MONTHLY_COST_USD=5
# AI_MAX_OUTPUT_TOKENS=800
# External agent service (not shipped here) is release-gated in code. These
# credentials are insufficient until a reviewed versioned eval manifest lands.
# AGENT_SERVICE_URL=https://agents.example.com
# AGENT_API_TOKEN=replace_with_at_least_32_random_characters
# AGENT_PROVIDER_NAME=external-agent-service / AGENT_MODEL_NAME=upstream-managed
# AGENT_INPUT_USD_PER_MILLION=5 / AGENT_OUTPUT_USD_PER_MILLION=5

# Observability & throttling
# METRICS_TOKEN=replace_with_at_least_32_random_characters   # enables /api/metrics
# NEXT_PUBLIC_SENTRY_DSN=
# Production must explicitly set RATE_LIMIT_BACKEND=postgres or redis.
# RATE_LIMIT_BACKEND=postgres
# RATE_LIMIT_MEMORY_MAX_ENTRIES=10000  # bounded strict outage fallback
# UPSTASH_REDIS_REST_URL= / UPSTASH_REDIS_REST_TOKEN=        # required when backend=redis
# Production enforces CSP by default. Set false only as a temporary rollback while investigating reports.
# CSP_ENFORCE=true

# Backup runbook
# BACKUP_RETENTION_DAYS=30
# BACKUP_DIR=./backups/neon

# IoT ingest (optional)
# IOT_INGEST_SECRET=replace_with_at_least_32_random_characters
# IOT_SYSTEM_USER_ID=00000000-0000-4000-8000-000000000000

# Perf/load-test tunables (dev only)
BUNDLE_MAX_TOTAL_KB=10000
BUNDLE_MAX_ROUTE_KB=2500
