# School SIS — web environment contract
# Copy to .env.local for local development. Do not commit real secrets.
#
# Two sections:
#   1) REQUIRED — the deployment gate (`pnpm deployment:check --target production`) fails
#      without these. This is the complete must-have set.
#   2) OPTIONAL — capabilities are opt-in. Leave them unset to ship a lean deploy;
#      the app degrades gracefully (no online payments, in-app notifications only,
#      etc.). Enable a capability by setting its selector + secrets.

# ─────────────────────────────────────────────────────────────────────────────
# 1) REQUIRED CORE
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated production tenant base domains (hostnames only, no protocol).
# Example: school.example.edu,portal.example.edu   (localhost is fine for dev)
TENANT_BASE_HOSTS=localhost

# Local Postgres (scripts/local-db.sh, port 5433, pgvector). DIRECT_URL and
# PLATFORM_DATABASE_URL may be the same owner URL locally. In Vercel,
# DATABASE_URL and PLATFORM_DATABASE_URL must be separate pooled tenant and
# platform roles; the production direct migration URL belongs only in GitHub
# as NEON_PRODUCTION_DIRECT_URL.
DATABASE_URL=postgresql://postgres@localhost:5433/school_sis?sslmode=disable
PLATFORM_DATABASE_URL=postgresql://postgres@localhost:5433/school_sis?sslmode=disable
DIRECT_URL=postgresql://postgres@localhost:5433/school_sis?sslmode=disable
# Managed integrations may expose the direct URL under this alias instead:
# DATABASE_URL_UNPOOLED=postgresql://...
# Release workflows also bind each URL to its expected database role:
# DEPLOYMENT_RUNTIME_ROLE=school_sis_runtime
# DEPLOYMENT_PLATFORM_ROLE=school_sis_platform
# DEPLOYMENT_MIGRATION_ROLE=school_sis_migrator
# Deployed databases require verify-full. Their URLs may only include
# sslmode=verify-full and optional channel_binding=require; connection identity,
# session, and TLS query overrides are rejected. Disable is local-only.
# DATABASE_SSL_MODE=verify-full

# Secrets — each at least 32 random characters.
SESSION_SECRET=replace_with_at_least_32_random_characters
PII_ENCRYPTION_KEY=replace_with_at_least_32_random_characters   # or set ENCRYPTION_KEY instead
JOB_DISPATCH_SECRET=replace_with_at_least_32_random_characters  # secures /api/jobs/dispatch
CRON_SECRET=replace_with_at_least_32_random_characters          # required when using Vercel Cron
METRICS_TOKEN=replace_with_at_least_32_random_characters        # required for deployment readiness

# Tenant isolation uses a transaction-bound HMAC verified inside Postgres.
# Generate the secret from at least 32 random bytes and encode it as unpadded
# base64url. Production and preview must use different secrets, key IDs, and
# deployment-specific audiences. Never use a NEXT_PUBLIC_ name for this secret.
# These well-known values are local-only and match the disposable CI migrator;
# remote and production runtimes never receive this fallback.
TENANT_CONTEXT_AUDIENCE=ci:local:database
TENANT_CONTEXT_SIGNING_KEY_ID=local-ci-v1
TENANT_CONTEXT_SIGNING_SECRET=localCI_0123456789abcdefghijklmnopqrstuvwxyzABCDEF
# During a two-key rotation, the deploy migrator alone also receives both:
# TENANT_CONTEXT_PREVIOUS_KEY_ID=local-v0
# TENANT_CONTEXT_PREVIOUS_SIGNING_SECRET=replace_with_43_to_128_base64url_characters
# Set only on a later release after the new key is proven promoted; do not
# combine this flag with the previous-key variables.
# TENANT_CONTEXT_RETIRE_PREVIOUS_KEY=true

# ─────────────────────────────────────────────────────────────────────────────
# 2) OPTIONAL — capabilities (unset = disabled, app degrades gracefully)
# ─────────────────────────────────────────────────────────────────────────────

# Runtime modes
NODE_ENV=development
INTEGRATIONS_MODE=live
JOB_QUEUE_MODE=database
# Development/test only: both values are required to enable signed-delivery
# short-circuits. Production startup rejects either mock setting.
# ENABLE_INTEGRATION_MOCKS=true
# INTEGRATIONS_MODE=mock

# Online payments — single provider. Unset/none = payments disabled.
# PAYMENT_PROVIDER=stripe        # or: razorpay
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...

# External notifications — unset = in-app only. Opt in per channel.
# REQUIRED_NOTIFICATION_CHANNELS=email,sms,push,whatsapp
# EMAIL_PROVIDER=smtp            # ₹0 via Gmail App Password / Brevo Free, or: resend (3,000/mo free)
# RESEND_API_KEY=...
# SMTP_HOST= / SMTP_PORT=587 / SMTP_USER= / SMTP_PASS= / EMAIL_FROM=
# SMS_PROVIDER=msg91             # or: twilio
# MSG91_AUTH_KEY=... / MSG91_WEBHOOK_SECRET=...
# TWILIO_ACCOUNT_SID=AC... / TWILIO_AUTH_TOKEN=... / TWILIO_FROM_NUMBER=...
# PUSH_PROVIDER=firebase         # ₹0 Firebase Cloud Messaging (FCM)
# FIREBASE_PROJECT_ID= / FIREBASE_CLIENT_EMAIL= / FIREBASE_PRIVATE_KEY=
# WHATSAPP_PROVIDER=waha         # ₹0 self-hosted (ops/whatsapp/docker-compose.whatsapp-free.yml), or: evolution, meta_cloud
# WAHA_BASE_URL=http://127.0.0.1:3005 / WAHA_API_KEY=... / WHATSAPP_WEBHOOK_SECRET=...
# EVOLUTION_BASE_URL=... / EVOLUTION_API_KEY=... / EVOLUTION_INSTANCE=...
# WHATSAPP_PHONE_NUMBER_ID=... / WHATSAPP_ACCESS_TOKEN=... / WHATSAPP_APP_SECRET=... / WHATSAPP_WEBHOOK_VERIFY_TOKEN=...

# LTI 1.3 — configure either one platform with the fields below, or multiple
# platforms with LTI_PLATFORMS_JSON. LTI_STATE_SECRET may reuse SESSION_SECRET.
# The trusted platform must map its OIDC `sub` to the corresponding School SIS
# user UUID. Launches fail closed if the local account or learner/teacher role differs.
# LTI_ISSUER=https://lms.example.edu
# LTI_CLIENT_ID=
# LTI_JWKS_URL=https://lms.example.edu/.well-known/jwks.json
# LTI_AUTHORIZATION_URL=https://lms.example.edu/oidc/auth
# LTI_DEPLOYMENT_ID=
# LTI_TENANT_ID=00000000-0000-4000-8000-000000000000
# LTI_REDIRECT_URI=https://sis.example.edu/api/lti/launch
# LTI_STATE_SECRET=replace_with_at_least_32_random_characters
# LTI_PLATFORMS_JSON=[{"issuer":"https://lms.example.edu","clientId":"...","jwksUrl":"https://lms.example.edu/.well-known/jwks.json","authorizationUrl":"https://lms.example.edu/oidc/auth","deploymentId":"...","tenantId":"00000000-0000-4000-8000-000000000000","redirectUri":"https://sis.example.edu/api/lti/launch"}]

# File storage — unset = upload/download features unavailable. Prefer Cloudflare R2 (10 GB/mo free, zero egress).
# R2_ACCOUNT_ID= / R2_ACCESS_KEY_ID= / R2_SECRET_ACCESS_KEY= / R2_BUCKET_NAME=
# STORAGE_CDN_BASE_URL=https://cdn.example.com
# AWS_REGION= / AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= / AWS_S3_BUCKET=   # S3 fallback

# AI Copilot (native TypeScript bounded assistant in src/lib/ai/) — unset = Copilot cleanly disabled.
# Supports 100% ₹0 / $0 free-tier providers with automatic ordered fallback:
# CEREBRAS_API_KEY=              # ₹0 free developer tier (default llama3.1-8b)
# GROQ_API_KEY=                  # ₹0 free developer tier (default llama-3.3-70b-versatile)
# GEMINI_API_KEY=                # ₹0 Google AI Studio free tier (default gemini-2.5-flash)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1   # ₹0 local open-weight models, no external key
# OPENAI_API_KEY=                # Optional paid OpenAI provider

# Lead capture & anti-bot (Cloudflare Turnstile is ₹0 unlimited; CRM webhook is optional)
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# MARKETING_CRM_WEBHOOK_URL=
# MARKETING_CRM_WEBHOOK_SECRET=

# Observability & throttling
# NEXT_PUBLIC_SENTRY_DSN=
# Production must explicitly set RATE_LIMIT_BACKEND=postgres or redis.
# RATE_LIMIT_BACKEND=postgres
# RATE_LIMIT_MEMORY_MAX_ENTRIES=10000  # bounded strict outage fallback
# UPSTASH_REDIS_REST_URL= / UPSTASH_REDIS_REST_TOKEN=        # required when backend=redis
# Production enforces CSP by default. Set false only as a temporary rollback while investigating reports.
# CSP_ENFORCE=true

# Backup runbook
# BACKUP_RETENTION_DAYS=30
# BACKUP_DIR=./backups/neon

# IoT ingest (optional)
# IOT_INGEST_SECRET=replace_with_at_least_32_random_characters
# IOT_SYSTEM_USER_ID=00000000-0000-4000-8000-000000000000

# Perf/load-test tunables (dev only)
BUNDLE_MAX_TOTAL_KB=10000
BUNDLE_MAX_ROUTE_KB=2500
