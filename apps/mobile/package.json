{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-navigation/native": "^7.3.4",
    "@react-navigation/native-stack": "^7.17.6",
    "@stripe/stripe-react-native": "^0.67.0",
    "expo": "~56.0.12",
    "expo-constants": "~56.0.18",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node scripts/run-development-expo.cjs start",
    "android": "node scripts/run-development-expo.cjs start --android",
    "ios": "node scripts/run-development-expo.cjs start --ios",
    "web": "node scripts/run-development-expo.cjs start --web",
    "expo:dev": "node scripts/run-development-expo.cjs",
    "typecheck": "tsc --noEmit",
    "test:release-gate": "node --test tests/release-gate.test.cjs",
    "release:check": "node scripts/mobile-release-gate.cjs --target production",
    "build:production": "node scripts/mobile-release-gate.cjs --target production && expo export",
    "submit:production": "node scripts/mobile-release-gate.cjs --target store && eas submit --profile production",
    "eas-build-pre-install": "node scripts/mobile-release-gate.cjs"
  },
  "private": true
}
